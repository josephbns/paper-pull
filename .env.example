# Private settings: copy to .env (git-ignored) and fill in. Never put real values in this
# example file. Public collaboration criteria live in profiles/<name>.toml instead.

# Free key from https://openalex.org/settings/api (see docs/SETUP.md)
OPENALEX_API_KEY=
# Your contact email; scholarly APIs ask callers to identify themselves
PUBMON_EMAIL=
# Optional: the profile to use when a command has no --profile, e.g. cleveland-clinic
PUBMON_PROFILE=
# Optional: path to your real master workbook (kept outside this folder), read-only
PUBMON_MASTER=
